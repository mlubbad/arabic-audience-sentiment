# Copy frontend variables to apps/web/.env.local only when configuring live development.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Paddle.js's client-side token (test_... on the sandbox, live_... in
# production). Public by Paddle's design; it can only open a checkout.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox
# The public origin, without a trailing slash: the canonical link, the
# hreflang alternates, the share-card URL and the sitemap all carry it.
# Defaults to the preview host when unset.
VITE_SITE_URL=https://app.sky-develop.net
# "true" lets search engines index the public pages: the robots meta,
# robots.txt and the X-Robots-Tag header all flip together at build time.
# Anything else (or unset) keeps the site noindex. See docs/seo.md.
VITE_SITE_PUBLIC=false
# Server/worker configuration only. Never prefix secrets with VITE_.
APP_BASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=
WORKER_API_BASE_URL=
WORKER_CREDENTIAL=
SENTIMENT_MODEL_ID=
SENTIMENT_MODEL_REVISION=
MODEL_DEVICE=
GEMINI_API_KEY=
# Paddle Billing: the API key drives scripts/paddle-sync-prices.mjs, the
# webhook secret verifies the paddle-webhook function. Both are server-side
# only; the browser holds nothing but VITE_PADDLE_CLIENT_TOKEN above.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
HF_HOME=
RAW_DATA_DIR=

# Whether the dashboard is permitted to read live data at all. Anything other
# than "live" keeps the whole deployment on the sanitized fixture. It is a
# ceiling, not a switch: with it set, a signed-out visitor still gets the demo
# and only a signed-in user with a workspace of their own reads live rows.
VITE_DASHBOARD_SOURCE=live
