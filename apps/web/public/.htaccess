# Apache configuration for the private preview deployment.
#
# Kept in public/ so every build carries it. Writing it straight into dist/
# meant the next build silently dropped it — and with it the password on a
# deployment whose whole premise is that it is not published openly.
#
# The password itself is not here. It lives in .htpasswd_app one level above
# the document root, which is why that file cannot be served.
AuthType Basic
AuthName "Sentiment MVP - private preview"
AuthUserFile /home/u101542/domains/app.sky-develop.net/.htpasswd_app
Require valid-user

# Single-page app: an unknown path is the router's business, not the
# filesystem's. Without this, refreshing on /account is a 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The bundle carries a content hash in its name, so it can be cached hard —
  # but only when there is a bundle to cache. Without the status guard this
  # rule also stamped `immutable` on the 401 challenge page, because the
  # challenge is served *for* the requested filename and matches on it.
  #
  # Cloudflare then did exactly what it was told. On 2026-09-15 a single
  # unauthenticated request to each hashed asset pinned a 401 at the edge for a
  # year: `cf-cache-status: HIT`, served in place of the JavaScript even to a
  # request carrying valid credentials, and immune to a revalidating
  # `Cache-Control: no-cache`. The app loaded its index.html and then nothing.
  # Any crawler, or any browser that asks for an asset before the password is
  # entered, does the same thing — this did not need an operator to trigger it.
  #
  # `immutable` is a promise that the body will never change. An error page
  # about a file is not that file, so it must never carry the promise.
  # An `expr` condition is only evaluated on a successful response here. That
  # was measured, three times, against the deployed host: a rule carrying one
  # is simply absent from the 401, whether it is written `set` or `always set`,
  # `== 200`, `!= 200` or `-ge 400`. So a condition can withhold a header from
  # an error. It can never add one to it.
  #
  # Which decides the shape of everything below: the refusal is unconditional
  # and comes first, and the promise is the exception layered on top of it. Not
  # a style choice — it is the only order in which both halves can be delivered
  # by a server that will not evaluate a condition when things go wrong.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-store"
    Header set Cache-Control "public, max-age=31536000, immutable" \
      "expr=%{REQUEST_STATUS} == 200"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-store"
    Header set Cache-Control "no-cache" "expr=%{REQUEST_STATUS} == 200"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
