# Apache configuration for the deployed front end.
#
# Kept in public/ so every build carries it. Writing it straight into dist/
# meant the next build silently dropped it.
#
# 2026-09-16: the password is gone at the owner's explicit instruction — the
# site is out of "private preview" and every route answers without one now.
# The Basic Auth block this file used to carry named a credential file that
# lives one level above the document root, out of FTP's reach; removing that
# block from here is the whole of what "removing the password" means from
# this repo — there was never a second lever to pull.

# Two kinds of address, in this order.
#
# A public page — the landing, /pricing, the legal documents, each also
# under /en — is prerendered by scripts/prerender.mjs into <path>/index.html
# (the landing into index.html itself). The first rule serves that file for
# `/pricing` and `/pricing/` alike, as an internal rewrite: left to mod_dir, a
# request for the directory without its slash is answered with a 301 to the
# slashed form, and the canonical address of every page here has no slash.
#
# Everything else that is not a file or a directory is the router's business,
# not the filesystem's, and gets app.html — the same template with an empty
# root, which the shell renders from nothing. Not index.html: that is the
# prerendered landing now, and a shell route hydrating against the landing's
# markup would throw the markup away and render twice.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /app.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The bundle carries a content hash in its name, so it can be cached hard —
  # but only when there is a bundle to cache. A request for a name that no
  # longer exists (a deploy in flight, a stale link) 404s, and this file used
  # to stamp `immutable` on that too, because `Header set` applies to the
  # response for the requested filename regardless of its status. On
  # 2026-09-15 the same shape of bug did this to a 401 challenge and pinned
  # it at Cloudflare's edge for a year, immune to revalidation. There is no
  # 401 left to repeat that story, but a 404 still can, so the guard stays:
  # the refusal is unconditional and first, the promise is the exception on
  # top of it, and it only fires when `expr=%{REQUEST_STATUS} == 200` —
  # `Header always set` with an `expr`, or a `>=` comparison, never evaluates
  # on this host; both were tried and measured.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-store"
    Header set Cache-Control "public, max-age=31536000, immutable" \
      "expr=%{REQUEST_STATUS} == 200"
  </FilesMatch>
  # .txt and .xml too: robots.txt and sitemap.xml are the two files whose
  # meaning changes on the day the flag flips, and without a header here the
  # edge cached the closed robots.txt and served it after the open one was
  # deployed (2026-09-17, `cf-cache-status: HIT`, no purge credential).
  <FilesMatch "\.(html|json|txt|xml)$">
    Header set Cache-Control "no-store"
    Header set Cache-Control "no-cache" "expr=%{REQUEST_STATUS} == 200"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  # The site-wide refusal to be indexed. scripts/prerender.mjs removes this
  # one line from the built copy when VITE_SITE_PUBLIC=true — the same flag
  # that opens robots.txt and turns every public page's robots meta to
  # "index, follow" — so the three signals cannot disagree. Until then a
  # crawler is told twice, by the page and by the header, and the header wins.
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
