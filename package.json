{
  "name": "arabic-audience-sentiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npm run dev -w @sentiment/web",
    "build": "npm run build -w @sentiment/web",
    "lint": "eslint . && npm run worker:lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'apps/web/src/**/*.{ts,tsx,css}' 'apps/web/vite.config.ts' 'apps/web/scripts/*.mjs' 'packages/contracts/src/*.ts' 'supabase/functions/**/*.ts' 'supabase/tests/*.ts' 'tests/e2e/*.ts' 'tests/live/*.ts' 'scripts/*.{mjs,ts}' '*.{json,js,ts}'",
    "format:check": "prettier --check 'apps/web/src/**/*.{ts,tsx,css}' 'apps/web/vite.config.ts' 'apps/web/scripts/*.mjs' 'packages/contracts/src/*.ts' 'supabase/functions/**/*.ts' 'supabase/tests/*.ts' 'tests/e2e/*.ts' 'tests/live/*.ts' 'scripts/*.{mjs,ts}' '*.{json,js,ts}'",
    "test": "vitest run --exclude \"supabase/tests/**\"",
    "test:db": "vitest run supabase/tests",
    "test:e2e": "playwright test",
    "test:e2e:build": "E2E_BUILD=1 playwright test --project public-build",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "worker:test": "uv --directory workers/python --cache-dir ../../.cache/uv run --frozen pytest",
    "worker:lint": "uv --directory workers/python --cache-dir ../../.cache/uv run --frozen ruff check .",
    "label:draw": "PYTHONPATH=src uv --directory workers/python --cache-dir ../../.cache/uv run --frozen python -m labelling.cli",
    "worker:run-once": "PYTHONPATH=src uv --directory workers/python --cache-dir ../../.cache/uv run --frozen python -m server.manual_run",
    "label:score": "PYTHONPATH=src uv --directory workers/python --cache-dir ../../.cache/uv run --frozen python -m labelling.score_cli",
    "worker:collect": "PYTHONPATH=src uv --directory workers/python --cache-dir ../../.cache/uv run --frozen python -m collectors.cli",
    "omnichannel:check": "PYTHONPATH=src uv --directory workers/python --cache-dir ../../.cache/uv run --frozen python src/collectors/diagnostics.py",
    "telegram:auth": "uv --directory workers/python --cache-dir ../../.cache/uv run --frozen python ../../scripts/telegram_auth.py",
    "deploy:preview": "sh scripts/deploy-preview.sh",
    "db:migrate:remote": "node scripts/apply-migrations-remote.mjs",
    "functions:deploy": "node scripts/deploy-functions.mjs",
    "functions:check": "node scripts/deploy-functions.mjs --check",
    "db:snapshot": "node scripts/snapshot-schema.mjs",
    "db:snapshot:check": "node scripts/snapshot-schema.mjs --check",
    "demo:fixture": "node apps/web/scripts/make-demo-fixture.mjs",
    "check:functions": "npx --yes deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "setup": "npm ci --cache .cache/npm && uv --directory workers/python --cache-dir ../../.cache/uv sync --frozen && playwright install chromium",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:functions && npm test && npm run test:db && npm run worker:test && npm run build && npm run check:secrets && npm run check:migrations"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "5.0.5"
  }
}
